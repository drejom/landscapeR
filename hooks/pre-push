#!/usr/bin/env bash
# pre-push: mirrors locally available CI checks. PR-body policy is CI-only.
# Roadmap integrity, repository hygiene, and review ratchet always run; package
# checks are scoped to changed files.
#
# Checks (all blocking):
#   1. Roadmap integrity    — roadmap agrees with live GitHub issue state
#   2. R tests pass         — R/  or tests/  changed
#   3. ADR coverage         — any new register_strategy() call has a backing ADR
#   4. ADR governance       — unique numbers, valid statuses, resolution issues
#   5. Registry compliance  — no if/switch dispatchers, no hardcoded config
#   6. Repository hygiene   — no unexpected untracked files outside .scratch/
#   7. Review ratchet       — bounded incident-backed review memory is valid
#
# Add [skip-hooks] to any commit message to bypass (emergencies only).

set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "[pre-push] Cannot resolve the repository root." >&2
  exit 1
}
cd "$REPO_ROOT"

# ── Collect pushed commits ──────────────────────────────────────────────────
COMMITS=()
while read -r local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    base=$(git merge-base HEAD "origin/main" 2>/dev/null || true)
    [[ -n "$base" ]] && COMMITS+=("$base..$local_sha") || COMMITS+=("$local_sha")
  else
    COMMITS+=("$remote_sha..$local_sha")
  fi
done

[[ ${#COMMITS[@]} -eq 0 ]] && exit 0

# ── Skip-hooks escape hatch ─────────────────────────────────────────────────
if git log --format="%s %b" "${COMMITS[@]}" 2>/dev/null | grep -qF "[skip-hooks]"; then
  echo "[pre-push] [skip-hooks] found — bypassing all checks."
  exit 0
fi

# ── Collect changed files ───────────────────────────────────────────────────
CHANGED=$(git diff --name-only "${COMMITS[@]}" 2>/dev/null | sort -u || true)

needs_check() { echo "$CHANGED" | grep -q "^${1}"; }

RAN=0
FAILED=0

run_check() {
  local label="$1"; shift
  echo "  → $label"
  if ! "$@"; then
    echo "  ✗ $label failed"
    FAILED=1
  fi
}

echo "[pre-push] Checking $(echo "$CHANGED" | wc -l | tr -d ' ') changed file(s)..."

# ── 1. Roadmap integrity ─────────────────────────────────────────────────────
check_roadmap() {
  local open_issues_json
  open_issues_json=$(mktemp)
  if ! gh issue list \
      --repo drejom/landscapeR \
      --state open \
      --limit 200 \
      --json number > "$open_issues_json"; then
    rm -f "$open_issues_json"
    return 1
  fi
  python3 scripts/check-roadmap.py --open-issues-json "$open_issues_json"
  local status=$?
  rm -f "$open_issues_json"
  return "$status"
}

RAN=1
echo "[pre-push] Roadmap integrity"
run_check "roadmap integrity" check_roadmap

# ── 2. R tests ───────────────────────────────────────────────────────────────
if needs_check "R/" || needs_check "tests/"; then
  RAN=1
  echo "[pre-push] R tests"
  run_check "devtools::test()" Rscript -e "
    scratch_root <- file.path(getwd(), '.scratch')
    dir.create(scratch_root, recursive = TRUE, showWarnings = FALSE)
    options(device = function(...) {
      grDevices::pdf(file = file.path(scratch_root, 'Rplots.pdf'), ...)
    })
    suppressPackageStartupMessages({
      devtools::load_all('.', quiet = TRUE)
    })
    results <- devtools::test(reporter = 'progress')
    df <- as.data.frame(results)
    n_fail <- sum(df[['failed']], na.rm = TRUE)
    n_err  <- sum(df[['error']],  na.rm = TRUE)
    if (n_fail + n_err > 0) {
      cat(sprintf('\n%d failure(s), %d error(s)\n', n_fail, n_err))
      quit(status = 1)
    }
  "
fi

# ── 3. ADR coverage ──────────────────────────────────────────────────────────
if needs_check "R/" || needs_check "decisions/"; then
  RAN=1
  echo "[pre-push] ADR coverage"
  run_check "ADR coverage" python3 scripts/check-adr-coverage.py
fi

# ── 4. ADR governance ────────────────────────────────────────────────────────
RAN=1
echo "[pre-push] ADR governance"
run_check "ADR governance" python3 scripts/check-adr-governance.py

# ── 5. Registry compliance ───────────────────────────────────────────────────
if needs_check "R/"; then
  RAN=1
  echo "[pre-push] registry compliance"
  run_check "registry compliance" bash scripts/check-registry-compliance.sh
fi

# ── 6. Repository hygiene ────────────────────────────────────────────────────
RAN=1
echo "[pre-push] repository hygiene"
run_check "repository hygiene" bash scripts/check-repo-hygiene.sh

# ── 7. Review ratchet ────────────────────────────────────────────────────────
RAN=1
echo "[pre-push] review ratchet"
run_check "review ratchet" python3 scripts/check-review-ratchet.py

[[ $RAN -eq 0 ]] && echo "[pre-push] No watched paths changed — skipping." && exit 0
[[ $FAILED -ne 0 ]] && echo "[pre-push] Checks failed. Fix the above before pushing." && exit 1

echo "[pre-push] All checks passed."
